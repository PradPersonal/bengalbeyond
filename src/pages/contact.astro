---
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site, whatsappLink } from '../config';
---
<Base title="Contact" description={`Contact ${site.name} to plan your tour in and around Kolkata.`}>
  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-2">
    <div>
      <h1 class="font-display text-4xl font-bold">Plan your trip</h1>
      <p class="mt-3 text-stone-600">
        The fastest way to reach us is WhatsApp — we usually reply within an hour. Tell us your dates, group size and
        what you would like to see.
      </p>
      <ul class="mt-8 space-y-4">
        <li>
          <a href={whatsappLink('Hi! I would like to plan a tour.')} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-xl bg-white p-4 shadow-sm hover:shadow">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#25D366] font-bold text-white">W</span>
            <span><span class="block text-sm text-stone-500">WhatsApp</span>{site.phone}</span>
          </a>
        </li>
        <li>
          <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="flex items-center gap-3 rounded-xl bg-white p-4 shadow-sm hover:shadow">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-600 font-bold text-white">☎</span>
            <span><span class="block text-sm text-stone-500">Call</span>{site.phone}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="flex items-center gap-3 rounded-xl bg-white p-4 shadow-sm hover:shadow">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-stone-700 font-bold text-white">@</span>
            <span><span class="block text-sm text-stone-500">Email</span>{site.email}</span>
          </a>
        </li>
      </ul>
    </div>
    <EnquiryForm />
  </section>
</Base>
