---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TourImage from '../../components/TourImage.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { formatPrice, whatsappLink } from '../../config';

// Builds one page per Markdown file in src/content/tours/
export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return tours.map((tour) => ({ params: { id: tour.id }, props: { tour } }));
}

const { tour } = Astro.props;
const t = tour.data;
const { Content } = await render(tour);

const facts = [
  { label: 'Duration', value: t.duration },
  { label: 'Location', value: t.location },
  t.distance && { label: 'Distance', value: t.distance },
  t.groupSize && { label: 'Group size', value: t.groupSize },
].filter(Boolean) as { label: string; value: string }[];
---
<Base title={t.title} description={t.summary}>
  <TourImage image={t.image} alt={t.title} label="" category={t.category} class="h-56 w-full md:h-80" />

  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 lg:grid-cols-3">
    <article class="lg:col-span-2">
      <a href="/tours" class="text-sm font-medium text-brand-600 hover:text-brand-700">← All tours</a>
      <p class="mt-4 text-sm font-semibold tracking-wide text-brand-600 uppercase">{t.category}</p>
      <h1 class="mt-1 font-display text-4xl font-bold">{t.title}</h1>
      <p class="mt-3 text-lg text-stone-600">{t.summary}</p>

      <dl class="mt-6 grid grid-cols-2 gap-4 rounded-2xl bg-white p-5 shadow-sm sm:grid-cols-4">
        {facts.map((f) => (
          <div>
            <dt class="text-xs tracking-wide text-stone-500 uppercase">{f.label}</dt>
            <dd class="mt-1 font-medium">{f.value}</dd>
          </div>
        ))}
      </dl>

      {t.highlights.length > 0 && (
        <section class="mt-8">
          <h2 class="font-display text-2xl font-semibold">Highlights</h2>
          <ul class="mt-3 grid gap-2 sm:grid-cols-2">
            {t.highlights.map((h) => (
              <li class="flex gap-2 text-stone-700"><span class="text-brand-600">✓</span>{h}</li>
            ))}
          </ul>
        </section>
      )}

      <div class="prose-tour mt-4">
        <Content />
      </div>

      {t.includes.length > 0 && (
        <section class="mt-8 rounded-2xl bg-brand-50 p-5">
          <h2 class="font-semibold">What's included</h2>
          <ul class="mt-2 flex flex-wrap gap-2">
            {t.includes.map((i) => <li class="rounded-full bg-white px-3 py-1 text-sm text-stone-700">{i}</li>)}
          </ul>
        </section>
      )}
    </article>

    <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
        <p class="text-sm text-stone-500">Starting from</p>
        <p class="font-display text-3xl font-bold text-brand-700">{formatPrice(t.price)}<span class="text-base font-normal text-stone-500"> / person</span></p>
        <a
          href={whatsappLink(`Hi! I'm interested in the "${t.title}" tour. Is it available?`)}
          target="_blank"
          rel="noopener"
          class="mt-4 block rounded-lg bg-[#25D366] px-4 py-3 text-center font-semibold text-white transition hover:brightness-95"
        >
          Book on WhatsApp
        </a>
      </div>
      <EnquiryForm tourName={t.title} />
    </aside>
  </div>
</Base>
