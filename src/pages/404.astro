---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <h1 class="font-display text-5xl font-bold text-brand-700">404</h1>
    <p class="mt-4 text-stone-600">Looks like this lane leads nowhere. Let's get you back on track.</p>
    <a href="/tours" class="mt-6 inline-block rounded-lg bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700">Browse tours</a>
  </section>
</Base>
