---
import { site } from '../config';

interface Props {
  tourName?: string;
}
const { tourName = '' } = Astro.props;
// With a Web3Forms key the form emails you; without one it opens WhatsApp pre-filled.
const useEmail = Boolean(site.web3formsKey);
const input = 'mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 focus:border-brand-500 focus:outline-none';
---
<form
  id="enquiry-form"
  class="space-y-4 rounded-2xl border border-stone-200 bg-white p-6 shadow-sm"
  method="POST"
  action={useEmail ? 'https://api.web3forms.com/submit' : undefined}
  data-mode={useEmail ? 'email' : 'whatsapp'}
  data-whatsapp={site.whatsapp}
>
  {useEmail && <input type="hidden" name="access_key" value={site.web3formsKey} />}
  {useEmail && <input type="hidden" name="subject" value={`New tour enquiry - ${site.name}`} />}
  <!-- Honeypot field to catch spam bots -->
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

  <h3 class="font-display text-xl font-semibold">Send an enquiry</h3>

  <label class="block">
    <span class="text-sm font-medium text-stone-700">Your name</span>
    <input name="name" required class={input} />
  </label>
  <label class="block">
    <span class="text-sm font-medium text-stone-700">Phone / WhatsApp</span>
    <input name="phone" type="tel" required class={input} />
  </label>
  <div class="grid grid-cols-2 gap-4">
    <label class="block">
      <span class="text-sm font-medium text-stone-700">Preferred date</span>
      <input name="date" type="date" class={input} />
    </label>
    <label class="block">
      <span class="text-sm font-medium text-stone-700">People</span>
      <input name="people" type="number" min="1" value="2" class={input} />
    </label>
  </div>
  <label class="block">
    <span class="text-sm font-medium text-stone-700">Tour</span>
    <input name="tour" value={tourName} placeholder="Which tour are you interested in?" class={input} />
  </label>
  <label class="block">
    <span class="text-sm font-medium text-stone-700">Message</span>
    <textarea name="message" rows="3" class={input}></textarea>
  </label>

  <button type="submit" class="w-full rounded-lg bg-brand-600 px-4 py-3 font-semibold text-white transition hover:bg-brand-700">
    {useEmail ? 'Send enquiry' : 'Send on WhatsApp'}
  </button>
  <p id="enquiry-status" class="text-center text-sm text-stone-500" aria-live="polite"></p>
</form>

<script>
  const form = document.getElementById('enquiry-form') as HTMLFormElement | null;
  const status = document.getElementById('enquiry-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (data.get('botcheck')) return;

    if (form.dataset.mode === 'whatsapp') {
      const lines = [
        "Hi! I'd like to enquire about a tour.",
        `Name: ${data.get('name')}`,
        `Phone: ${data.get('phone')}`,
        data.get('tour') && `Tour: ${data.get('tour')}`,
        data.get('date') && `Date: ${data.get('date')}`,
        `People: ${data.get('people')}`,
        data.get('message') && `Message: ${data.get('message')}`,
      ].filter(Boolean);
      const url = `https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`;
      window.open(url, '_blank', 'noopener');
      return;
    }

    if (status) status.textContent = 'Sending...';
    try {
      const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message);
      form.reset();
      if (status) status.textContent = 'Thank you! We will get back to you shortly.';
    } catch {
      if (status) status.textContent = 'Sorry, something went wrong. Please message us on WhatsApp.';
    }
  });
</script>
