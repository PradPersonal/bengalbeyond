---
import { site, whatsappLink } from '../config';
const year = new Date().getFullYear();
---
<footer class="mt-16 bg-stone-900 text-stone-300">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3">
    <div>
      <p class="font-display text-xl font-bold text-white">{site.name}</p>
      <p class="mt-2 text-sm">{site.tagline}</p>
    </div>
    <div class="text-sm">
      <p class="mb-2 font-semibold text-white">Explore</p>
      <ul class="space-y-1">
        <li><a href="/tours" class="hover:text-white">All tours</a></li>
        <li><a href="/about" class="hover:text-white">About us</a></li>
        <li><a href="/contact" class="hover:text-white">Contact</a></li>
      </ul>
    </div>
    <div class="text-sm">
      <p class="mb-2 font-semibold text-white">Get in touch</p>
      <ul class="space-y-1">
        <li><a href={whatsappLink('Hi! I would like to know more about your tours.')} class="hover:text-white">WhatsApp: {site.phone}</a></li>
        <li><a href={`tel:${site.phone.replace(/\s/g, '')}`} class="hover:text-white">Call: {site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></li>
        <li>{site.address}</li>
      </ul>
    </div>
  </div>
  <p class="border-t border-stone-800 py-4 text-center text-xs text-stone-500">© {year} {site.name}</p>
</footer>
